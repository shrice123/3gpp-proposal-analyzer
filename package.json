{
  "name": "3gpp-proposal-analyzer",
  "productName": "3GPP Proposal Analyzer",
  "description": "Local-first 3GPP proposal download, background preparation, analysis, chat and reporting desktop app.",
  "author": "Proposal Insight",
  "version": "0.3.1",
  "private": true,
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:backend": "python3 backend/run.py",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:desktop": "electron .",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:backend": "node scripts/build-backend.mjs",
    "build:desktop": "npm run build:renderer && electron-builder --config electron-builder.online.yml",
    "build:desktop:offline": "npm run build:renderer && electron-builder --config electron-builder.offline.yml",
    "typecheck": "tsc --noEmit",
    "test:backend": "PYTHONPATH=backend .venv/bin/python -m unittest discover -s backend/tests -v",
    "test:launcher": "bash scripts/test-launcher.sh",
    "test:full": "bash scripts/test-full.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.83.0",
    "@carbon/react": "^1.111.1",
    "@carbon/styles": "^1.110.1",
    "electron-updater": "^6.6.2",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.proposalinsight.3gpp",
    "artifactName": "3GPP-Proposal-Analyzer-${version}-${os}-${arch}.${ext}"
  }
}
